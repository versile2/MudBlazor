@using System.Net.Http.Json
@using MudBlazor.Examples.Data.Models
@namespace MudBlazor.Docs.Examples
@inject HttpClient httpClient

<MudDataGrid T="Element" Items="@_elements" Filterable="true" FilterMode="@_filterMode" RowsPerPage="5">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="Nr" Filterable="false" />
        <PropertyColumn Property="x => x.Sign" />
        <PropertyColumn Property="x => x.Name" />
        <PropertyColumn Property="x => x.Position" />
        <PropertyColumn Property="x => x.Molar" Title="Molar mass" />
        <PropertyColumn Property="x => x.Group" Title="Category">
            <FilterTemplate Context="filterContext">
                <MudStack Row Spacing="1" Style="width: 100%">
                    <MudToggleGroup T="CategoryFilterMode"
                                    SelectionMode="SelectionMode.SingleSelection"
                                    Size="Size.Small"
                                    Value="@GetFilterMode(filterContext.FilterDefinition!)"
                                    ValueChanged="@(mode => SetFilterModeAsync(filterContext, mode))">
                        <MudToggleItem Value="@CategoryFilterMode.Include">Include</MudToggleItem>
                        <MudToggleItem Value="@CategoryFilterMode.Exclude">Exclude</MudToggleItem>
                    </MudToggleGroup>
                    <MudSelect T="string" MultiSelection="true"
                               SelectedValues="@GetFilterValues(filterContext.FilterDefinition!)"
                               SelectedValuesChanged="@(values => SetFilterValues(filterContext, values))"
                               FullWidth="true" Dense="true" Margin="@Margin.Dense"
                               Label="Value" Clearable="true" Placeholder="Select categories">
                        @foreach (var category in _categories)
                        {
                            <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>
            </FilterTemplate>
        </PropertyColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Element" />
    </PagerContent>
</MudDataGrid>

<div class="d-flex flex-wrap mt-4">
    <MudRadioGroup T="DataGridFilterMode" @bind-Value="_filterMode">
        <MudRadio Dense="true" Value="@DataGridFilterMode.ColumnFilterMenu" Color="Color.Primary">Column Menu</MudRadio>
        <MudRadio Dense="true" Value="@DataGridFilterMode.ColumnFilterRow">Column Row</MudRadio>
    </MudRadioGroup>
</div>

@code {
    private IEnumerable<Element> _elements = new List<Element>();
    private readonly List<string> _categories = new();
    private DataGridFilterMode _filterMode = DataGridFilterMode.ColumnFilterMenu;

    private enum CategoryFilterMode
    {
        Include,
        Exclude
    }

    protected override async Task OnInitializedAsync()
    {
        _elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable") ?? new List<Element>();
        _categories.AddRange(_elements.Select(x => x.Group).Distinct().OrderBy(x => x).ToList());
    }

    private static IReadOnlyCollection<string> GetFilterValues(IFilterDefinition<Element> filterDefinition)
    {
        return filterDefinition.Value as IReadOnlyCollection<string> ?? Array.Empty<string>();
    }

    private static CategoryFilterMode GetFilterMode(IFilterDefinition<Element> filterDefinition) =>
        filterDefinition.Operator switch
        {
            nameof(CategoryFilterMode.Exclude) => CategoryFilterMode.Exclude,
            _ => CategoryFilterMode.Include
        };

    private async Task SetFilterModeAsync(FilterContext<Element> filterContext, CategoryFilterMode mode)
    {
        var filterDefinition = filterContext.FilterDefinition!;
        filterDefinition.Operator = mode.ToString();
        UpdateFilterDefinition(filterDefinition);
        await filterContext.Actions.ApplyFilterAsync(filterDefinition);
    }

    private async Task SetFilterValues(FilterContext<Element> filterContext, IEnumerable<string> values)
    {
        var filterDefinition = filterContext.FilterDefinition!;
        var selectedValues = values?.ToList() ?? [];
        filterDefinition.Value = selectedValues.Count > 0 ? selectedValues : null;
        UpdateFilterDefinition(filterDefinition);
        await filterContext.Actions.ApplyFilterAsync(filterDefinition);
    }

    private static void UpdateFilterDefinition(IFilterDefinition<Element> filterDefinition)
    {
        if (filterDefinition is not FilterDefinition<Element> filterDef)
        {
            return;
        }

        var selectedValues = GetFilterValues(filterDefinition);
        if (selectedValues.Count == 0)
        {
            filterDef.FilterFunction = null;
            return;
        }

        filterDef.FilterFunction = GetFilterMode(filterDefinition) switch
        {
            CategoryFilterMode.Exclude => item => !selectedValues.Contains(item.Group),
            _ => item => selectedValues.Contains(item.Group)
        };
    }
}
